<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 8 reached end of support in Nov 2026. If you only have the .NET 8 SDK, change this to net8.0-windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FloatingStopwatch</AssemblyName>
    <RootNamespace>FloatingStopwatch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Floating Stopwatch</Product>
    <!-- Must stay false: WPF's font cache needs real culture data (true crashes at startup in MajorLanguages). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
